# Copy to .env and fill in real values. Never commit .env.

# ---- App ----
DEBUG=False

# ---- Database ----
# For local dev with docker-compose: host=db, port=5432.
# For host-mounted dev: host=localhost, port=5433 (or whatever you exposed).
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=logistics

# ---- Telegram ----
# Get token from @BotFather. Chat ID = ID of the admin user, NOT the bot.
TELEGRAM_BOT_TOKEN=000000000:replace-with-token-from-botfather
BOT_ADMIN_CHAT_ID=000000000

# ---- Notifications ----
NOTIFICATION_RETRY_ATTEMPTS=3
NOTIFICATION_TIMEOUT=30
